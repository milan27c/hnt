---
import SectionHeading from '../ui/SectionHeading.astro';
import MediaFrame from '../ui/MediaFrame.astro';
import { processIntro, processVideo, processSteps } from '../../data/process';

const hasVideo = Boolean(processVideo.src);
---

<section id="how-we-work" class="process" aria-labelledby="process-heading">
  <div class="process__glow" aria-hidden="true"></div>

  <div class="container-site process__inner">
    <div class="video" data-video={hasVideo ? processVideo.src : undefined}>
      <MediaFrame
        src={processVideo.poster}
        alt={processVideo.alt}
        focusX={processVideo.focusX}
        sizes="(min-width: 80rem) 1280px, 100vw"
        widths={[768, 1200, 1672]}
        class="video__poster"
        parallax
      />
      <div class="video__overlay" aria-hidden="true"></div>

      <div class="video__content">
        <SectionHeading
          id="process-heading"
          eyebrow={processIntro.eyebrow}
          title={processIntro.title.lead}
          accent={processIntro.title.accent}
          lead={processIntro.lead}
          align="start"
          tone="dark"
        />

        {
          hasVideo ? (
            <button type="button" class="play" data-video-play aria-label={processVideo.label}>
              <span class="play__ring" aria-hidden="true" />
              <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
                <path d="M8 5.6v12.8c0 .8.9 1.3 1.6.8l9.6-6.4c.6-.4.6-1.2 0-1.6L9.6 4.8C8.9 4.3 8 4.8 8 5.6Z" fill="currentColor" />
              </svg>
            </button>
          ) : (
            <span class="play" aria-hidden="true">
              <span class="play__ring" />
              <svg viewBox="0 0 24 24" width="26" height="26" focusable="false">
                <path d="M8 5.6v12.8c0 .8.9 1.3 1.6.8l9.6-6.4c.6-.4.6-1.2 0-1.6L9.6 4.8C8.9 4.3 8 4.8 8 5.6Z" fill="currentColor" />
              </svg>
            </span>
          )
        }
      </div>
    </div>

    <div class="steps" data-steps>
      <div class="steps__rail" aria-hidden="true">
        <span class="steps__fill" data-steps-fill></span>
      </div>
      <ol class="steps__list">
        {
          processSteps.map((step, i) => (
            <li class="step" data-step>
              <span class="step__number" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="step__body" data-reveal>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--section-y);
    background-color: var(--color-bg-dark);
    background-image: var(--grad-deep);
    color: var(--color-text-on-dark);
  }

  .process__glow {
    position: absolute;
    top: -10%;
    left: 50%;
    z-index: -1;
    width: min(90rem, 140%);
    aspect-ratio: 16 / 9;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--color-primary-500) 16%, transparent) 0%, transparent 62%);
    filter: blur(40px);
    pointer-events: none;
  }

  .process__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5rem);
  }

  /* ---------------------------------------------------------------------------
   * Video frame: poster, overlay and copy. Swaps to a playing video when a file is supplied.
   * ------------------------------------------------------------------------- */
  .video {
    position: relative;
    display: flex;
    min-height: 36rem;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 10%, transparent);
    border-radius: var(--radius-xl);
    background-color: var(--color-navy-950);
    box-shadow: var(--shadow-lg);
  }

  .video :global(.video__poster) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .video__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, var(--color-navy-950) 0%, color-mix(in srgb, var(--color-navy-950) 88%, transparent) 38%, color-mix(in srgb, var(--color-navy-950) 30%, transparent) 72%, color-mix(in srgb, var(--color-navy-950) 45%, transparent) 100%),
      radial-gradient(ellipse 60% 50% at 85% 20%, color-mix(in srgb, var(--color-primary-500) 18%, transparent) 0%, transparent 100%);
  }

  .video__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column-reverse;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .video__content :global(.section-heading__title) {
    max-width: 16ch;
  }

  .video__content :global(.section-heading__lead) {
    max-width: 48ch;
  }

  /* Cyan play affordance with a slow pulse ring */
  .play {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 0;
    border-radius: var(--radius-pill);
    background-image: var(--grad-brand);
    box-shadow: var(--shadow-glow);
    color: var(--color-navy-900);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .play svg {
    position: relative;
    margin-left: 0.1875rem;
  }

  .play__ring {
    position: absolute;
    inset: -0.625rem;
    border: 1px solid color-mix(in srgb, var(--color-primary-400) 55%, transparent);
    border-radius: inherit;
    animation: play-pulse 2.4s var(--ease-out) infinite;
  }

  button.play {
    cursor: pointer;
  }

  button.play:hover {
    transform: scale(1.06);
  }

  button.play:focus-visible {
    outline-color: var(--color-primary-400);
    outline-offset: 0.875rem;
  }

  @keyframes play-pulse {
    0% {
      transform: scale(0.85);
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  .video :global(.video__player) {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: var(--color-navy-950);
  }

  .video:global(.is-playing) .video__content,
  .video:global(.is-playing) .video__overlay {
    visibility: hidden;
  }

  /* ---------------------------------------------------------------------------
   * Stepper: vertical on mobile and tablet, a row of four from desktop. The rail fills on scroll.
   * ------------------------------------------------------------------------- */
  .steps {
    --num: 3rem;
    --steps-gap: 2rem;
    position: relative;
  }

  /* Vertical: the script trims the bottom so the rail stops at the last number */
  .steps__rail {
    position: absolute;
    top: calc(var(--num) / 2);
    bottom: var(--rail-end, calc(var(--num) / 2));
    left: calc(var(--num) / 2 - 1px);
    width: 2px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: var(--color-navy-700);
  }

  .steps__fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: var(--grad-brand);
    transform-origin: top center;
  }

  .steps__list {
    position: relative;
    display: grid;
    gap: var(--steps-gap);
  }

  .step {
    display: grid;
    grid-template-columns: var(--num) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    align-content: start;
  }

  .step__number {
    display: grid;
    place-items: center;
    width: var(--num);
    height: var(--num);
    border-radius: var(--radius-pill);
    background-image: var(--grad-brand);
    box-shadow: var(--shadow-glow);
    font-size: var(--text-caption);
    line-height: 1;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-navy-900);
    transition:
      color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  /* Once the script is running, steps ahead of the fill sit in a quiet outline state */
  .steps:global(.is-tracking) .step:not(.is-active) .step__number {
    background-image: none;
    background-color: var(--color-surface-dark);
    box-shadow: inset 0 0 0 1px var(--color-navy-600);
    color: var(--color-text-on-dark-mut);
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.625rem;
  }

  .step__title {
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    letter-spacing: var(--text-h4--letter-spacing);
    font-weight: var(--text-h4--font-weight);
    color: var(--color-text-on-dark);
  }

  .step__text {
    max-width: 36ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-text-on-dark-mut);
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .video {
      min-height: 0;
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-2xl);
    }

    .video__content {
      flex-direction: row;
      align-items: flex-end;
    }

    .play {
      width: 5.5rem;
      height: 5.5rem;
    }
  }

  @media (min-width: 64rem) {
    .video {
      aspect-ratio: 16 / 9;
    }

    .steps {
      --steps-gap: 1.5rem;
    }

    /* Horizontal rail from the first number to the last */
    .steps__rail {
      top: calc(var(--num) / 2 - 1px);
      bottom: auto;
      left: calc(var(--num) / 2);
      right: calc((100% - var(--steps-gap) * 3) / 4 - var(--num) / 2);
      width: auto;
      height: 2px;
    }

    .steps__fill {
      transform-origin: left center;
    }

    .steps__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
    }

    .step__body {
      padding-top: 0.5rem;
    }
  }
</style>
