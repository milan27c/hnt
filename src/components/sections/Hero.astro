---
import { Image, getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import { heroScenes, heroActions, heroBroom } from '../../data/hero';
import cloudBank from '../../assets/images/clouds/bank.webp';
import cloudPuffA from '../../assets/images/clouds/puff-a.webp';
import cloudPuffB from '../../assets/images/clouds/puff-b.webp';
import cloudWisp from '../../assets/images/clouds/wisp.webp';

// Art directed sources: a 3:4 portrait below 768px, the 16:9 frame above it.
const mobileMedia = '(max-width: 47.99rem)';
const sourceFormats = ['avif', 'webp'] as const;
const scenePictures = await Promise.all(
  heroScenes.map(async (scene) => {
    const build = (src: typeof scene.image, widths: number[]) =>
      Promise.all(sourceFormats.map((format) => getImage({ src, widths, format })));
    const [mobile, desktop] = await Promise.all([build(scene.mobileImage, [480, 768, 1086]), build(scene.image, [768, 1280, 1672])]);
    return { mobile, desktop, fallback: desktop[1] };
  }),
);

const cloudLayers = [
  { key: 'bank', src: cloudBank },
  { key: 'left', src: cloudPuffA },
  { key: 'right', src: cloudPuffB },
  { key: 'wisp', src: cloudWisp },
  { key: 'core', src: cloudPuffB },
];

// Small PNG for the native cursor, used when the live broom is not running (reduced motion).
const cursorSize = 56;
const broomCursor = await getImage({ src: heroBroom.image, width: cursorSize, format: 'png' });
const cursorH = Math.round((cursorSize * heroBroom.image.height) / heroBroom.image.width);
const hotspot = `${Math.round((heroBroom.tip.x / 100) * cursorSize)} ${Math.round((heroBroom.tip.y / 100) * cursorH)}`;
const heroStyle = `--broom-cursor: url("${broomCursor.src}") ${hotspot}; --tip-x: ${heroBroom.tip.x}%; --tip-y: ${heroBroom.tip.y}%`;
---

<section id="top" class="hero" data-hero aria-labelledby="hero-heading" style={heroStyle}>
  <div class="hero__sticky">
    <div class="hero__stage" data-hero-stage>
      {
        heroScenes.map((scene, i) => {
          const Heading = i === 0 ? 'h1' : 'h2';
          const picture = scenePictures[i];
          return (
            <div class="scene" data-scene={scene.id}>
              <div class="scene__media" data-media>
                <picture>
                  {picture.mobile.map((img) => (
                    <source
                      media={mobileMedia}
                      type={`image/${img.options.format}`}
                      srcset={img.srcSet.attribute}
                      sizes="100vw"
                      width={scene.mobileImage.width}
                      height={scene.mobileImage.height}
                    />
                  ))}
                  {picture.desktop.map((img) => (
                    <source type={`image/${img.options.format}`} srcset={img.srcSet.attribute} sizes="100vw" />
                  ))}
                  <img
                    src={picture.fallback.src}
                    srcset={picture.fallback.srcSet.attribute}
                    sizes="100vw"
                    width={scene.image.width}
                    height={scene.image.height}
                    alt={scene.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    decoding="async"
                    class="scene__img"
                    data-img
                  />
                </picture>
                <div class="scene__scrim" aria-hidden="true" />
              </div>

              <div class="scene__content" data-content>
                <Heading class="scene__heading" id={i === 0 ? 'hero-heading' : undefined}>
                  <span class="scene__mask">
                    <span class="scene__line" data-rise>
                      {scene.heading.lead}
                      {scene.heading.accent && ' '}
                      {scene.heading.accent && <span class="scene__accent">{scene.heading.accent}</span>}
                    </span>
                  </span>
                </Heading>

                <p class="scene__body" data-item>
                  {scene.body}
                </p>

                {scene.hint && (
                  <p class="scene__hint" data-item data-hint>
                    <Image src={heroBroom.image} alt="" width={40} densities={[2]} class="scene__hint-broom" loading="eager" decoding="async" />
                    {scene.hint}
                  </p>
                )}

                {scene.showActions && (
                  <div class="scene__actions" data-item>
                    <Button href={heroActions.primary.href} arrow>
                      {heroActions.primary.label}
                    </Button>
                    <Button href={heroActions.secondary.href} variant="ghost-light">
                      {heroActions.secondary.label}
                    </Button>
                  </div>
                )}
              </div>
            </div>
          );
        })
      }

      <!-- Transition layers. Decorative and only shown in the scroll story. -->
      {
        ['a', 'b'].map((group) => (
          <div class={`hero__clouds hero__clouds--${group}`} data-clouds={group} aria-hidden="true">
            {cloudLayers.map((layer) => (
              <img
                src={layer.src.src}
                width={layer.src.width}
                height={layer.src.height}
                alt=""
                loading="lazy"
                decoding="async"
                class={`cloud cloud--${layer.key}`}
                data-cloud={layer.key}
              />
            ))}
          </div>
        ))
      }
      <div class="hero__veil" data-veil aria-hidden="true"></div>
      <div class="hero__glow" data-glow aria-hidden="true"></div>
      <div class="hero__top-scrim" aria-hidden="true"></div>

      <!-- Dust kicked up by the broom, drawn by scripts/dust.ts. -->
      <canvas class="hero__dust" data-dust aria-hidden="true"></canvas>

      <!-- Live broom pointer, positioned by scripts/sweep.ts. Its origin is the bristle edge. -->
      <div class="hero__broom" data-broom aria-hidden="true">
        <Image src={heroBroom.image} alt="" width={96} densities={[2]} class="hero__broom-img" loading="eager" decoding="async" />
      </div>

      <div class="hero__progress" aria-hidden="true">
        {
          heroScenes.map(() => (
            <span class="hero__progress-bar">
              <span class="hero__progress-fill" data-progress-fill />
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------------------
   * Base layout: four stacked scenes. This is the no JS and reduced motion view.
   * ------------------------------------------------------------------------- */
  .hero {
    position: relative;
    background-color: var(--color-navy-950);
  }

  .scene {
    position: relative;
    display: grid;
    min-height: 0;
    aspect-ratio: 3 / 4;
    overflow: clip;
    isolation: isolate;
  }

  .scene__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .scene__media :global(.scene__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scene__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--color-navy-950) 42%, transparent) 0%, transparent 26%),
      linear-gradient(to top, color-mix(in srgb, var(--color-navy-950) 38%, transparent) 0%, transparent 30%),
      radial-gradient(ellipse 58% 52% at 50% 54%, color-mix(in srgb, var(--color-navy-950) 56%, transparent) 0%, color-mix(in srgb, var(--color-navy-950) 14%, transparent) 100%);
  }

  .scene__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: calc(var(--header-h) + 1rem) var(--gutter) 3.5rem;
    text-align: center;
    color: var(--color-text-on-dark);
  }

  .scene__heading {
    max-width: 18ch;
    font-size: calc(var(--text-h2) * 0.64);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: var(--text-h2--font-weight);
    text-wrap: balance;
  }

  /* Masked rise: the heading block slides up from behind its own bottom edge */
  .scene__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .scene__line {
    display: block;
  }

  /* Neon accent: brand text gradient drifting across the words. Solid colour first as the fallback. */
  .scene__accent {
    color: var(--color-primary-300);
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .scene__accent {
      background-image: linear-gradient(
        100deg,
        var(--color-primary-500) 0%,
        var(--color-primary-200) 25%,
        var(--color-primary-600) 50%,
        var(--color-primary-200) 75%,
        var(--color-primary-500) 100%
      );
      background-size: 200% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      color: transparent;
      animation: accent-sheen var(--dur-sheen) linear infinite;
    }
  }

  @keyframes accent-sheen {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: -200% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene__accent {
      animation: none;
    }
  }

  .scene__body {
    max-width: 44ch;
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    letter-spacing: var(--text-body-lg--letter-spacing);
    color: color-mix(in srgb, var(--color-text-on-dark) 88%, transparent);
    text-wrap: pretty;
  }

  .scene__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.5rem;
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    font-weight: var(--text-caption--font-weight);
    color: color-mix(in srgb, var(--color-text-on-dark) 80%, transparent);
  }

  /* Broom sweeps side to side, pivoting on its bristles */
  .scene__hint :global(.scene__hint-broom) {
    width: 2.5rem;
    height: auto;
    transform-origin: var(--tip-x) var(--tip-y);
    animation: hint-sweep 1.8s var(--ease-inout) infinite;
  }

  @keyframes hint-sweep {
    0%,
    100% {
      transform: translateX(-0.25rem) rotate(-12deg);
    }
    50% {
      transform: translateX(0.25rem) rotate(10deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene__hint :global(.scene__hint-broom) {
      animation: none;
    }
  }

  .scene__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .hero__clouds,
  .hero__veil,
  .hero__glow,
  .hero__top-scrim,
  .hero__dust,
  .hero__broom,
  .hero__progress {
    display: none;
  }

  /* Broom pointer. The static layout uses a native cursor; the story swaps in the live broom. */
  @media (hover: hover) and (pointer: fine) {
    .hero {
      cursor: var(--broom-cursor), auto;
    }
  }

  @media (min-width: 48rem) {
    .scene {
      aspect-ratio: 16 / 9;
    }

    /* Copy anchored low in the frame; the progress bars sit clear of it in the corner */
    .scene__content {
      justify-content: flex-end;
      gap: 1.25rem;
      padding-bottom: 3.5rem;
    }

    .scene__heading {
      max-width: 16ch;
      font-size: calc(var(--text-display) * 0.64);
      line-height: var(--text-display--line-height);
      letter-spacing: var(--text-display--letter-spacing);
      font-weight: var(--text-display--font-weight);
    }

    .scene__actions {
      margin-top: 1rem;
    }
  }

  /* ---------------------------------------------------------------------------
   * Scroll story: one held frame, scenes layered, driven by scripts/hero.ts.
   * ------------------------------------------------------------------------- */
  :global(html.motion-ok) .hero {
    height: calc(100svh * (1 + var(--story-scroll)));
    background-color: var(--color-bg);
  }

  :global(html.motion-ok) .hero__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }

  :global(html.motion-ok) .hero__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: 100svh;
    overflow: clip;
    isolation: isolate;
    background-color: var(--color-navy-950);
  }

  /*
   * Mobile: the photo is a 3:4 frame at the top of the screen that fades into a navy
   * ground filling the rest of the viewport, with the story copy centred low on it.
   */
  @media (max-width: 47.99rem) {
    :global(html.motion-ok) .hero__stage {
      height: 100svh;
      aspect-ratio: auto;
      max-height: none;
    }

    :global(html.motion-ok) .scene__media {
      bottom: auto;
      height: min(133.333vw, 100%);
    }

    :global(html.motion-ok) .scene__scrim {
      background:
        linear-gradient(to bottom, color-mix(in srgb, var(--color-navy-950) 42%, transparent) 0%, transparent 24%),
        linear-gradient(to top, var(--color-navy-950) 0%, color-mix(in srgb, var(--color-navy-950) 72%, transparent) 14%, transparent 40%),
        radial-gradient(ellipse 80% 50% at 50% 70%, color-mix(in srgb, var(--color-navy-950) 22%, transparent) 0%, transparent 100%);
    }

    /* Copy starts just above the bottom of the photo, leaving room for the longest scene on short phones. */
    :global(html.motion-ok) .scene__content {
      justify-content: center;
      padding-top: min(calc(min(133.333vw, 100svh) - 8rem), calc(100svh - 22rem));
      padding-bottom: 4rem;
    }
  }

  :global(html.motion-ok) .scene {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    overflow: visible;
    isolation: auto;
  }

  :global(html.motion-ok) .scene__content {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  :global(html.motion-ok) .scene:global(.is-live) .scene__content :global(a) {
    pointer-events: auto;
  }

  /* Pre paint start states. JS takes over from here; the failsafe reveals scene one if it never runs. */
  :global(html.motion-ok) .scene:not(:first-child) .scene__media,
  :global(html.motion-ok) .scene:not(:first-child) .scene__content {
    opacity: 0;
  }

  :global(html.motion-ok) .scene:first-child [data-rise],
  :global(html.motion-ok) .scene:first-child [data-item] {
    opacity: 0;
    animation: hero-failsafe 0s linear 2.5s forwards;
  }

  :global(html.motion-ok) .hero:global(.is-ready) .scene:first-child [data-rise],
  :global(html.motion-ok) .hero:global(.is-ready) .scene:first-child [data-item] {
    animation: none;
  }

  @keyframes hero-failsafe {
    to {
      opacity: 1;
    }
  }

  /* Sweep surface: vertical pans stay native, horizontal ones drive the story. */
  :global(html.motion-ok) .hero__stage {
    touch-action: pan-y pinch-zoom;
  }

  :global(html.motion-ok) .hero__stage :global(img),
  :global(html.motion-ok) .hero__stage :global(a) {
    -webkit-user-drag: none;
  }

  :global(html.motion-ok) .hero:global(.is-sweeping) .hero__stage {
    user-select: none;
  }

  :global(html.motion-ok) .hero:global(.has-broom) .hero__stage {
    cursor: none;
  }

  :global(html.motion-ok) .hero:global(.has-broom) .hero__stage :global(a) {
    cursor: pointer;
  }

  :global(html.motion-ok) .hero__broom {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 6;
    width: 0;
    height: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform-origin: 0 0;
  }

  /* Sits under the broom so the bristles stay on top of their own dust */
  :global(html.motion-ok) .hero__dust {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 6;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__broom :global(.hero__broom-img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 5.5rem;
    max-width: none;
    height: auto;
    transform: translate(calc(var(--tip-x) * -1), calc(var(--tip-y) * -1));
  }

  /* Clouds */
  :global(html.motion-ok) .hero__clouds {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }

  :global(html.motion-ok) .hero__clouds--b {
    transform: scaleX(-1);
  }

  .cloud {
    position: absolute;
    max-width: none;
    height: auto;
    opacity: 0;
    user-select: none;
  }

  .cloud--bank {
    left: -80%;
    bottom: -30%;
    width: 260%;
  }

  .cloud--left {
    left: -95%;
    top: -12%;
    width: 170%;
  }

  .cloud--right {
    right: -95%;
    top: 18%;
    width: 170%;
  }

  .cloud--wisp {
    left: -60%;
    top: -18%;
    width: 220%;
  }

  .cloud--core {
    left: -45%;
    top: 5%;
    width: 190%;
  }

  :global(html.motion-ok) .hero__veil {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(ellipse 80% 80% at 50% 50%, var(--color-primary-50) 0%, var(--color-navy-100) 100%);
  }

  :global(html.motion-ok) .hero__glow {
    display: block;
    position: absolute;
    inset: -20%;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at 50% 55%, color-mix(in srgb, var(--color-primary-500) 16%, transparent) 0%, transparent 55%);
  }

  :global(html.motion-ok) .hero__top-scrim {
    display: block;
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    height: calc(var(--header-h) * 2);
    pointer-events: none;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-navy-950) 38%, transparent), transparent);
  }

  /* Quiet scene indicator in the bottom right corner */
  :global(html.motion-ok) .hero__progress {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
    z-index: 5;
    display: flex;
    gap: 0.25rem;
    opacity: 0.6;
  }

  .hero__progress-bar {
    position: relative;
    display: block;
    width: 1rem;
    height: 2px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-text-on-dark) 30%, transparent);
  }

  .hero__progress-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--color-text-on-dark);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (min-width: 48rem) {
    :global(html.motion-ok) .hero__stage {
      aspect-ratio: 16 / 9;
    }

    :global(html.motion-ok) .hero__progress {
      bottom: 1.5rem;
      gap: 0.375rem;
    }

    .hero__progress-bar {
      width: 1.5rem;
    }

    .cloud--bank {
      left: -25%;
      bottom: -40%;
      width: 150%;
    }

    .cloud--left {
      left: -32%;
      top: -22%;
      width: 78%;
    }

    .cloud--right {
      right: -32%;
      top: 2%;
      width: 78%;
    }

    .cloud--wisp {
      left: -15%;
      top: -30%;
      width: 130%;
    }

    .cloud--core {
      left: 8%;
      top: -12%;
      width: 84%;
    }
  }
</style>
