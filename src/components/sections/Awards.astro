---
import { Picture } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { awardsIntro, awards, awardsInfo } from '../../data/awards';
---

<section id="awards" class="awards" aria-labelledby="awards-heading">
  <div class="container-site">
    <SectionHeading id="awards-heading" eyebrow={awardsIntro.eyebrow} title={awardsIntro.title} lead={awardsIntro.lead} />

    <div class="awards__grid">
      <ul class="awards__list">
        {
          awards.map((award) => (
            <li class="awards__item" data-reveal>
              <article class="award-card" aria-labelledby={`award-${award.id}`}>
                <div class="award-card__media" data-parallax>
                  <span class="award-card__glow" aria-hidden="true" />
                  <span class="award-card__art">
                    <Picture
                      src={award.image}
                      alt={award.alt}
                      formats={['avif', 'webp']}
                      fallbackFormat="webp"
                      widths={[320, 480, 720]}
                      sizes="(min-width: 80rem) 320px, (min-width: 30rem) 38vw, 80vw"
                      loading="lazy"
                      decoding="async"
                      class="award-card__img"
                    />
                  </span>
                  <p class="award-card__badge">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                      <path
                        d="M5 2.5h6v3.2a3 3 0 0 1-6 0V2.5ZM5 3.8H3v1a2.2 2.2 0 0 0 2.2 2.2M11 3.8h2v1A2.2 2.2 0 0 1 10.8 7M8 8.7v2.6M5.5 13.5h5M6.5 11.3h3v2.2h-3z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {award.result}
                  </p>
                </div>

                <h3 id={`award-${award.id}`} class="award-card__title">
                  <span class="award-card__year">{award.year}</span>{' '}
                  <span class="award-card__name">{award.name}</span>
                </h3>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="awards__info" data-reveal>
        <article class="info-card" aria-labelledby="awards-info-heading">
          <span class="info-card__glow" aria-hidden="true"></span>
          <span class="info-card__tile" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" focusable="false">
              <circle cx="12" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.7" />
              <path d="m9.2 13.8-1.7 7 4.5-2.4 4.5 2.4-1.7-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
              <path d="m12 6.6.8 1.6 1.7.2-1.3 1.2.3 1.7-1.5-.8-1.5.8.3-1.7-1.3-1.2 1.7-.2.8-1.6Z" fill="currentColor" />
            </svg>
          </span>
          <h3 id="awards-info-heading" class="info-card__title">{awardsInfo.title}</h3>
          {awardsInfo.paragraphs.map((text) => <p class="info-card__text">{text}</p>)}
          <ul class="info-card__checks">
            {
              awardsInfo.highlights.map((item) => (
                <li>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
          <Button href={awardsInfo.cta.href} variant="ghost" arrow class="info-card__cta">{awardsInfo.cta.label}</Button>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .awards {
    padding-block: var(--section-y);
  }

  .awards__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .awards__list {
    display: grid;
    gap: 1rem;
  }

  .awards__item,
  .awards__info {
    display: flex;
  }

  /* ---------------------------------------------------------------------------
   * Award cards
   * ------------------------------------------------------------------------- */
  .award-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    padding: 0.75rem 0.75rem 1.5rem;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .award-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-md);
  }

  /* Light ground on purpose: the 2024 emblem has dark lettering on a transparent background */
  .award-card__media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-alt);
  }

  .award-card__glow {
    position: absolute;
    inset: 10% 5% 20%;
    border-radius: var(--radius-pill);
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 16%, transparent) 0%, transparent 70%);
  }

  /* Inset so the parallax drift in scripts/parallax.ts never reaches the tile edge */
  .award-card__art {
    position: absolute;
    inset: 9% 12%;
    transition:
      transform var(--dur-slow) var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
  }

  .award-card__art :global(picture) {
    display: contents;
  }

  .award-card__art :global(.award-card__img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px color-mix(in srgb, var(--color-navy-900) 12%, transparent));
  }

  .award-card:hover .award-card__art {
    transform: scale(1.04);
  }

  /* Grayscale at rest where hover exists; touch screens always see full colour */
  @media (hover: hover) {
    .award-card__art {
      filter: grayscale(1);
    }

    .award-card:hover .award-card__art,
    .award-card:focus-within .award-card__art {
      filter: grayscale(0);
    }
  }

  .award-card__badge {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem 0.375rem 0.625rem;
    border: 1px solid var(--color-primary-200);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-xs);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    font-weight: var(--text-caption--font-weight);
    color: var(--color-text-accent);
  }

  .award-card__title {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-inline: 0.75rem;
  }

  .award-card__year {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
    font-weight: var(--text-h3--font-weight);
    font-variant-numeric: tabular-nums;
    color: var(--color-navy-900);
  }

  .award-card__name {
    max-width: 28ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    font-weight: 500;
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------------------------
   * Info card
   * ------------------------------------------------------------------------- */
  .info-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding: clamp(1.5rem, 2.4vw, 2.25rem);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .info-card__glow {
    position: absolute;
    top: -40%;
    right: -40%;
    width: 90%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 16%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }

  .info-card__tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background-image: var(--grad-brand);
    color: var(--color-navy-900);
    box-shadow: var(--shadow-glow);
  }

  .info-card__title {
    position: relative;
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    letter-spacing: var(--text-h4--letter-spacing);
    font-weight: var(--text-h4--font-weight);
    color: var(--color-navy-900);
  }

  .info-card__text {
    position: relative;
    max-width: 62ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  .info-card__checks {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 0.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-gray-200);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .info-card__checks li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .info-card__checks svg {
    flex-shrink: 0;
    width: 1.375rem;
    height: 1.375rem;
    padding: 0.1875rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary-100);
    color: var(--color-primary-800);
  }

  .info-card :global(.info-card__cta) {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (min-width: 30rem) {
    .awards__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .award-card__media {
      aspect-ratio: 4 / 5;
    }
  }

  @media (min-width: 48rem) {
    .awards__grid,
    .awards__list {
      gap: 1.25rem;
    }
  }

  /* 12 column split: the two awards share 8, the info card takes 4 */
  @media (min-width: 64rem) {
    .awards__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .awards__list {
      grid-column: span 8;
    }

    .awards__info {
      grid-column: span 4;
    }
  }
</style>
