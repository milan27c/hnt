---
import SectionHeading from '../ui/SectionHeading.astro';
import MediaFrame from '../ui/MediaFrame.astro';
import { industriesIntro, industries, industriesImage, industriesCta, type IndustryIcon } from '../../data/industries';

// 24px stroke icons, drawn with currentColor.
const icons: Record<IndustryIcon, string> = {
  office: 'M4.5 21V4.8c0-.4.4-.8.8-.8h8.4c.4 0 .8.4.8.8V21M14.5 9h4.2c.4 0 .8.4.8.8V21M3 21h18M8 8h3M8 12h3M8 16h3',
  retail: 'M5.2 8h13.6l-1 11.9c0 .6-.5 1.1-1.1 1.1H7.3c-.6 0-1.1-.5-1.1-1.1L5.2 8ZM9 8V6.5a3 3 0 0 1 6 0V8',
  education: 'M2.5 9 12 4.5 21.5 9 12 13.5 2.5 9ZM6.5 11.2V16c0 1.6 2.5 3 5.5 3s5.5-1.4 5.5-3v-4.8M21.5 9v5',
  medical: 'M7 4h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3ZM12 8.5v7M8.5 12h7',
  industrial: 'M3 21V9.2L12 4l9 5.2V21M7 21v-8h10v8M7 17h10',
  strata: 'M6 21V4.8c0-.4.4-.8.8-.8h10.4c.4 0 .8.4.8.8V21M3 21h18M9.5 8h1M13.5 8h1M9.5 12h1M13.5 12h1M10.5 21v-4.5h3V21',
};
---

<section id="industries" class="industries" aria-labelledby="industries-heading">
  <div class="industries__inner">
    <div class="industries__content">
      <div class="industries__glow" aria-hidden="true"></div>
      <SectionHeading
        id="industries-heading"
        eyebrow={industriesIntro.eyebrow}
        title={industriesIntro.title}
        lead={industriesIntro.lead}
        align="start"
        tone="dark"
      />

      <ul class="industries__list" aria-label="Industries">
        {
          industries.map((industry) => (
            <li data-reveal>
              <div class="industry">
                <span class="industry__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                    <path d={icons[industry.icon]} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="industry__name">{industry.name}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="industries__cta" data-reveal>
        {industriesCta.text}
        <a href={industriesCta.href} class="text-link">
          {industriesCta.label}
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </p>
    </div>

    <MediaFrame
      src={industriesImage.src}
      alt={industriesImage.alt}
      focusX={industriesImage.focusX}
      focusY={industriesImage.focusY}
      sizes="(min-width: 64rem) 50vw, 100vw"
      widths={[480, 768, 1086]}
      class="industries__media"
      parallax
    >
      <p class="industries__caption">
        <span class="industries__caption-dot" aria-hidden="true"></span>
        {industriesImage.caption}
      </p>
    </MediaFrame>
  </div>
</section>

<style>
  .industries {
    background-color: var(--color-bg-dark);
    color: var(--color-text-on-dark);
  }

  .industries__inner {
    display: grid;
  }

  /* Gradient sits on the copy column so its teal end is not hidden behind the image */
  .industries__content {
    background-image: var(--grad-deep);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding-block: var(--section-y);
    padding-inline: var(--gutter);
    overflow: hidden;
  }

  .industries__glow {
    position: absolute;
    top: 10%;
    left: 0;
    z-index: -1;
    width: min(60rem, 120%);
    aspect-ratio: 4 / 3;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--color-primary-500) 16%, transparent) 0%, transparent 62%);
    filter: blur(40px);
    pointer-events: none;
  }

  .industries__list {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .industries__list > li {
    display: flex;
  }

  .industry {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    min-height: 4.5rem;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border: 1px solid var(--color-navy-700);
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--color-surface-dark) 72%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .industry__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--color-primary-500) 12%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary-500) 28%, transparent);
    color: var(--color-primary-400);
  }

  .industry__name {
    font-size: var(--text-body-sm);
    line-height: 1.35;
    font-weight: 500;
    color: var(--color-text-on-dark);
    text-wrap: balance;
  }

  .industries__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-top: 1.75rem;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-text-on-dark-mut);
  }

  /* Hairline at rest, cyan underline wipes in from the left on hover */
  .text-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--tap);
    font-weight: 500;
    color: var(--color-text-on-dark);
    text-decoration: none;
  }

  .text-link::before,
  .text-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.625rem;
    height: 1px;
    background-color: var(--color-navy-500);
  }

  .text-link::after {
    height: 2px;
    background-image: var(--grad-brand);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .text-link:hover::after,
  .text-link:focus-visible::after {
    transform: scaleX(1);
  }

  .text-link svg {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .text-link:hover svg {
    transform: translateX(4px);
  }

  .industries__inner :global(.industries__media) {
    aspect-ratio: 4 / 3;
  }

  .industries__caption {
    position: absolute;
    left: var(--gutter);
    bottom: 1.25rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem 0.5rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 20%, transparent);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-navy-900) 62%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    font-weight: var(--text-caption--font-weight);
    color: var(--color-text-on-dark);
  }

  .industries__caption-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: var(--radius-pill);
    background-image: var(--grad-brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary-500) 30%, transparent);
  }

  @media (min-width: 30rem) {
    .industries__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .industries__inner :global(.industries__media) {
      aspect-ratio: 16 / 9;
    }
  }

  /* Split 50/50: copy aligns to the site container on the left, the image bleeds to the right edge */
  @media (min-width: 64rem) {
    .industries__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .industries__content {
      justify-content: center;
      padding-inline-start: max(var(--gutter), calc(100% - var(--container) / 2));
      padding-inline-end: clamp(2.5rem, 5vw, 5rem);
    }

    .industries__inner :global(.industries__media) {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .industries__caption {
      left: 2rem;
      bottom: 2rem;
    }
  }
</style>
