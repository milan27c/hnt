---
import SectionHeading from '../ui/SectionHeading.astro';
import { Image } from 'astro:assets';
import { testimonialsIntro, testimonials } from '../../data/testimonials';

if (import.meta.env.PROD && testimonials.some((item) => item.sample)) {
  console.warn('[testimonials] Sample testimonials are still in src/data/testimonials.ts. Replace them with real client words before launch.');
}
---

<section id="testimonials" class="testimonials" aria-labelledby="testimonials-heading">
  <div class="container-site">
    <SectionHeading
      id="testimonials-heading"
      eyebrow={testimonialsIntro.eyebrow}
      title={testimonialsIntro.title}
      lead={testimonialsIntro.lead}
    />

    <div class="carousel" data-carousel role="region" aria-roledescription="carousel" aria-label="Client testimonials">
      <ul id="testimonials-track" class="carousel__track" data-carousel-track>
        {
          testimonials.map((item, i) => (
            <li class="carousel__slide" data-carousel-slide aria-roledescription="slide" aria-label={`${i + 1} of ${testimonials.length}`}>
              <div class="carousel__reveal" data-reveal>
                <figure class="quote-card">
                  <span class="quote-card__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                      <path
                        d="M10 6.5C6.6 7.6 4.5 10.3 4.5 13.8v3.7h5.2v-5.2H7.3c.2-2 1.3-3.3 3.2-4l-.5-1.8Zm9.5 0c-3.4 1.1-5.5 3.8-5.5 7.3v3.7h5.2v-5.2h-2.4c.2-2 1.3-3.3 3.2-4l-.5-1.8Z"
                        fill="currentColor"
                      />
                    </svg>
                  </span>
                  <blockquote class="quote-card__quote">
                    <p>{item.quote}</p>
                  </blockquote>
                  <figcaption class="quote-card__person">
                    <span class="quote-card__avatar">
                      <Image src={item.avatar} alt="" width={48} height={48} densities={[1, 2]} format="webp" loading="lazy" decoding="async" class="quote-card__avatar-img" />
                    </span>
                    <span class="quote-card__meta">
                      <span class="quote-card__name">{item.name}</span>
                      <span class="quote-card__role">
                        {item.role}, {item.company}
                      </span>
                    </span>
                  </figcaption>
                </figure>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="carousel__controls">
        <button type="button" class="carousel__button" data-carousel-prev aria-controls="testimonials-track" aria-label="Previous testimonial">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M13 8H3.5M7.5 3.5 3 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="carousel__button" data-carousel-next aria-controls="testimonials-track" aria-label="Next testimonial">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <p class="sr-only" aria-live="polite" data-carousel-status></p>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--section-y);
  }

  .carousel {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* Mobile and tablet: native swipe with snap points. The track bleeds to the screen edge. */
  .carousel__track {
    display: flex;
    gap: 1rem;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.5rem var(--gutter) 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    display: flex;
    flex: 0 0 min(86%, 24rem);
    scroll-snap-align: start;
  }

  .carousel__reveal {
    display: flex;
    width: 100%;
  }

  .quote-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    padding: clamp(1.5rem, 2.4vw, 2.25rem);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .quote-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-md);
  }

  .quote-card__mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background-image: var(--grad-brand);
    color: var(--color-navy-900);
  }

  .quote-card__quote {
    flex: 1;
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    letter-spacing: var(--text-body-lg--letter-spacing);
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .quote-card__person {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .quote-card__avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    overflow: hidden;
    background-color: var(--color-navy-100);
  }

  .quote-card__avatar :global(.quote-card__avatar-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-pill);
  }

  .quote-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .quote-card__name {
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .quote-card__role {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    color: var(--color-text-muted);
  }

  .carousel__controls {
    display: none;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  :global(html.js) .carousel__controls {
    display: flex;
  }

  .carousel__button {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    color: var(--color-navy-900);
    cursor: pointer;
    transition:
      border-color var(--dur-base) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .carousel__button:hover {
    border-color: var(--color-primary-700);
  }

  .carousel__button[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
  }

  .carousel__button[aria-disabled='true']:hover {
    border-color: var(--color-gray-300);
  }

  @media (min-width: 48rem) {
    .carousel__slide {
      flex-basis: calc((100% - 1.25rem) / 2);
    }

    .carousel__track {
      gap: 1.25rem;
    }
  }

  /* Desktop: all three at once */
  @media (min-width: 64rem) {
    .carousel__track {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    :global(html.js) .carousel__controls {
      display: none;
    }
  }
</style>
