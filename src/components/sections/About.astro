---
import SectionHeading from '../ui/SectionHeading.astro';
import MediaFrame from '../ui/MediaFrame.astro';
import { aboutIntro, aboutImage, aboutStory, aboutStats } from '../../data/about';
---

<section id="about" class="about" aria-labelledby="about-heading">
  <div class="container-site">
    <SectionHeading id="about-heading" eyebrow={aboutIntro.eyebrow} title={aboutIntro.title} lead={aboutIntro.lead} />

    <div class="about__grid">
      <MediaFrame
        src={aboutImage.src}
        alt={aboutImage.alt}
        focusX={aboutImage.focusX}
        focusY={aboutImage.focusY}
        sizes="(min-width: 80rem) 480px, (min-width: 48rem) 90vw, 100vw"
        widths={[480, 768, 1200]}
        class="about__media"
        data-reveal
      >
        <p class="about__badge">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M8 14.5s4.5-4.2 4.5-7.9A4.5 4.5 0 0 0 3.5 6.6c0 3.7 4.5 7.9 4.5 7.9Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="8" cy="6.5" r="1.6" fill="currentColor" />
          </svg>
          {aboutImage.badge}
        </p>
      </MediaFrame>

      <div class="about__cards">
        <article class="about-card" aria-labelledby="about-story-heading" data-reveal>
          <span class="about-card__tile" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" focusable="false">
              <path d="M12 3 5 5.8v5.4c0 4.4 3 8.2 7 9.8 4-1.6 7-5.4 7-9.8V5.8L12 3Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
              <path d="m8.8 12.2 2.2 2.2 4.2-4.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h3 id="about-story-heading" class="about-card__title">{aboutStory.title}</h3>
          {aboutStory.paragraphs.map((text) => <p class="about-card__text">{text}</p>)}
          <ul class="about-card__values" aria-label="Our values">
            {aboutStory.values.map((value) => <li>{value}</li>)}
          </ul>
        </article>

        <article class="about-card about-card--stats" aria-labelledby="about-stats-heading" data-reveal>
          <span class="about-card__glow" aria-hidden="true"></span>
          <h3 id="about-stats-heading" class="about-card__title">{aboutStats.title}</h3>
          <dl class="stats">
            {
              aboutStats.stats.map((stat) => (
                <div class="stat">
                  <dt class="stat__label">
                    {stat.label}
                    {stat.detail && <span class="stat__detail">{stat.detail}</span>}
                  </dt>
                  <dd class="stat__value">
                    <span data-counter data-to={stat.value}>{stat.value}</span>
                    {stat.suffix && <span class="stat__suffix">{stat.suffix}</span>}
                  </dd>
                </div>
              ))
            }
          </dl>
          <ul class="about-card__checks">
            {
              aboutStats.highlights.map((item) => (
                <li>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-y);
  }

  .about__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .about__grid :global(.about__media) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
  }

  .about__badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    right: 1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 20%, transparent);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-navy-900) 62%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    font-weight: var(--text-caption--font-weight);
    color: var(--color-text-on-dark);
  }

  .about__badge svg {
    flex-shrink: 0;
    color: var(--color-primary-400);
  }

  .about__cards {
    display: grid;
    gap: 1rem;
  }

  .about-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 2.4vw, 2.25rem);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .about-card__tile {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background-image: var(--grad-brand);
    color: var(--color-navy-900);
    box-shadow: var(--shadow-glow);
  }

  .about-card__title {
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    letter-spacing: var(--text-h4--letter-spacing);
    font-weight: var(--text-h4--font-weight);
    color: var(--color-navy-900);
  }

  .about-card__text {
    max-width: 62ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  .about-card__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .about-card__values li {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-alt);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    font-weight: var(--text-caption--font-weight);
    color: var(--color-navy-800);
  }

  /* Stats card */
  .about-card__glow {
    position: absolute;
    top: -40%;
    right: -40%;
    width: 90%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 16%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }

  .stats {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .stat:first-child {
    padding-top: 0.25rem;
    border-top: 0;
  }

  .stat__value {
    order: -1;
    display: flex;
    align-items: baseline;
    font-size: var(--text-stat);
    line-height: var(--text-stat--line-height);
    letter-spacing: var(--text-stat--letter-spacing);
    font-weight: var(--text-stat--font-weight);
    font-variant-numeric: tabular-nums;
    color: var(--color-navy-900);
  }

  /* Large display type, so primary 700 clears 3:1 */
  .stat__suffix {
    color: var(--color-primary-700);
  }

  .stat__label {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .stat__detail {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .about-card__checks {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-gray-200);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .about-card__checks li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .about-card__checks svg {
    flex-shrink: 0;
    width: 1.375rem;
    height: 1.375rem;
    padding: 0.1875rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary-100);
    color: var(--color-primary-800);
  }

  @media (min-width: 48rem) {
    .about__grid {
      gap: 1.25rem;
    }

    .about__grid :global(.about__media) {
      aspect-ratio: 16 / 9;
    }

    .about__badge {
      left: 1.25rem;
      bottom: 1.25rem;
    }

    .about__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  /* 12 column split: image on 5, the two vertical cards share 7 */
  @media (min-width: 80rem) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .about__grid :global(.about__media) {
      grid-column: span 5;
      aspect-ratio: auto;
      min-height: 32rem;
    }

    .about__cards {
      grid-column: span 7;
    }
  }
</style>
