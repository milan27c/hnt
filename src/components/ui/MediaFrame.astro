---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image, Picture } from 'astro:assets';

interface Props extends Omit<HTMLAttributes<'div'>, 'style'> {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  /** Horizontal focal point in percent, used when the frame crops the image. */
  focusX?: number;
  /** Vertical focal point in percent, used when the frame crops the image. */
  focusY?: number;
  imgClass?: string;
  /** Oversizes the image so scripts/parallax.ts can drift it inside the frame. */
  parallax?: boolean;
}

const { src, alt, sizes, widths = [480, 768, 1200], focusX = 50, focusY = 50, class: className, imgClass, parallax = false, ...rest } = Astro.props;

// SVG placeholders are served as is; raster images get modern formats.
const isVector = src.format === 'svg';
const usable = widths.filter((w) => w <= src.width);
const imgWidths = usable.length ? usable : [src.width];
---

<div
  class:list={['media-frame', { 'media-frame--parallax': parallax }, className]}
  style={`--focus-x: ${focusX}%; --focus-y: ${focusY}%`}
  data-parallax={parallax ? '' : undefined}
  {...rest}
>
  {
    isVector ? (
      <Image src={src} alt={alt} loading="lazy" decoding="async" class:list={['media-frame__img', imgClass]} />
    ) : (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={imgWidths}
        sizes={sizes}
        loading="lazy"
        decoding="async"
        class:list={['media-frame__img', imgClass]}
      />
    )
  }
  <slot />
</div>

<style>
  .media-frame {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-navy-800);
  }

  .media-frame :global(picture) {
    display: contents;
  }

  .media-frame :global(.media-frame__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus-x) var(--focus-y);
  }

  /* 12 percent taller than the frame, so a drift of up to 12 percent never exposes an edge */
  .media-frame--parallax :global(.media-frame__img) {
    top: -6%;
    height: 112%;
  }
</style>
